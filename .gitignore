# ROS 2 / colcon build artifacts (workspace)
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# colcon artifacts if ever run from the repo root by mistake (wrong-arch on Jetson)
/build/
/install/
/log/

# Python
*.pyc
__pycache__/

# Editors
.vscode/

# Machine-specific DDS profile (different peer/interface IPs per machine — never commit)
config/fastdds_cable.xml

# Recorded teach-and-repeat routes (route_recorder_node's default output_dir) —
# per-session driving data, not source
/routes/

# ros2 run tf2_tools view_frames debug dumps (repo root, timestamped) —
# regeneratable, not source
/frames_*.gv
/frames_*.pdf
