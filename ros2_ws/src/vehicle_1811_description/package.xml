<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vehicle_1811_description</name>
  <version>0.1.0</version>
  <description>
    URDF/xacro description for the 1811 Nova sub-scale vehicle:
    base_link, Ouster OS1 lidar, four ZED X cameras, and wheels.
    Extrinsics are tape-measured placeholders — see TODO-MEASURE tags.
  </description>
  <maintainer email="ba201301@gmail.com">1811 team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
