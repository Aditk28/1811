<?xml version="1.0"?>
<!-- ================================================================
     vehicle_1811 top-level robot description.

     Coordinate convention (REP-103):
       x = forward, y = left, z = up, all lengths in METRES, angles in RADIANS.

     base_link sits at the CENTRE OF THE REAR AXLE, projected to the GROUND.
     (Ackermann convention: pure pursuit / RTP expect the control point at
      the rear axle. If your firmware/controller assumes a different origin,
      change base_link placement here and nowhere else.)

     >>> EVERY value marked  # TODO-MEASURE  is a placeholder. <<<
     Measure it with a tape measure against the real vehicle and edit it here.
     Getting the lidar transform wrong makes KISS-ICP build a self-consistent
     map that is rotated relative to the car — silently wrong. This is the one
     blocking step (roadmap Section 5, step 1). Verify in RViz before moving on.
     ================================================================ -->
<robot name="vehicle_1811" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find vehicle_1811_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find vehicle_1811_description)/urdf/vehicle_1811.macros.xacro"/>

  <!-- ===================== VEHICLE GEOMETRY ====================== -->
  <!-- Chassis bounding box (visual only). -->
  <xacro:property name="chassis_len"   value="1.00"/>   <!-- TODO-MEASURE  bumper-to-bumper -->
  <xacro:property name="chassis_width" value="0.60"/>   <!-- TODO-MEASURE  widest body point -->
  <xacro:property name="chassis_height" value="0.30"/>  <!-- TODO-MEASURE  deck height above axle -->

  <!-- Drivetrain geometry. WHEEL_BASE and MAX_TURN_ANGLE also feed RTP /
       pure-pursuit tuning (roadmap Section 6). Measure them off the chassis. -->
  <xacro:property name="wheel_base"  value="0.55"/>     <!-- TODO-MEASURE  front axle to rear axle -->
  <xacro:property name="track_width" value="0.50"/>     <!-- TODO-MEASURE  left wheel to right wheel -->
  <xacro:property name="wheel_radius" value="0.11"/>    <!-- TODO-MEASURE -->
  <xacro:property name="wheel_width"  value="0.06"/>    <!-- TODO-MEASURE -->

  <!-- Sensor mast: where the lidar + camera ring sit above base_link.
       These are the numbers that matter most — measure carefully. -->
  <xacro:property name="mast_x" value="0.25"/>          <!-- TODO-MEASURE  fwd of rear axle (near vehicle centre) -->
  <xacro:property name="mast_y" value="0.00"/>          <!-- TODO-MEASURE  lateral offset (0 = centreline) -->
  <xacro:property name="mast_top_z" value="0.55"/>      <!-- TODO-MEASURE  height of lidar base above ground -->

  <!-- Camera ring: 4 ZED X close together around the mast, one per direction.
       ring_r  = horizontal distance of each camera from the mast centre.
       cam_z   = camera height above ground (default: just below the lidar).
       Adjust per-camera yaw/tilt below if a camera is angled. -->
  <xacro:property name="ring_r" value="0.06"/>          <!-- TODO-MEASURE  cameras "close together" -->
  <xacro:property name="cam_z"  value="0.50"/>          <!-- TODO-MEASURE -->
  <xacro:property name="cam_pitch" value="0.0"/>        <!-- TODO-MEASURE  down-tilt (+ = nose down) -->

  <!-- ===================== BASE FRAME =========================== -->
  <!-- base_link at ground level. base_footprint is the flat ground projection
       many stacks expect; here they coincide since base_link is already at z=0. -->
  <link name="base_footprint"/>
  <link name="base_link">
    <visual>
      <!-- chassis box centred over the wheelbase, lifted to axle height -->
      <origin xyz="${wheel_base/2} 0 ${wheel_radius + chassis_height/2}" rpy="0 0 0"/>
      <geometry><box size="${chassis_len} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="chassis_grey"/>
    </visual>
  </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===================== WHEELS =============================== -->
  <!-- base_link is at the rear axle, so rear wheels are at x=0. -->
  <xacro:wheel name="wheel_rear_left"   parent="base_link" x="0"          y="${ track_width/2}" z="${wheel_radius}" radius="${wheel_radius}" width="${wheel_width}"/>
  <xacro:wheel name="wheel_rear_right"  parent="base_link" x="0"          y="${-track_width/2}" z="${wheel_radius}" radius="${wheel_radius}" width="${wheel_width}"/>
  <xacro:wheel name="wheel_front_left"  parent="base_link" x="${wheel_base}" y="${ track_width/2}" z="${wheel_radius}" radius="${wheel_radius}" width="${wheel_width}"/>
  <xacro:wheel name="wheel_front_right" parent="base_link" x="${wheel_base}" y="${-track_width/2}" z="${wheel_radius}" radius="${wheel_radius}" width="${wheel_width}"/>

  <!-- ===================== LIDAR ================================ -->
  <!-- Ouster OS1-070-128U-AX. Only os_sensor is placed here; the ouster-ros
       driver publishes os_sensor->os_lidar and os_sensor->os_imu from metadata.
       rpy below is the sensor's mounting orientation. If the connector faces a
       known direction you can zero yaw and account for it in os_lidar via the
       driver, but usually leave the driver's internal transform alone and set
       the physical mount orientation here. -->
  <xacro:ouster_os1 parent="base_link"
                    x="${mast_x}" y="${mast_y}" z="${mast_top_z}"
                    roll="0" pitch="0" yaw="0"/>   <!-- TODO-MEASURE mounting rpy -->

  <!-- ===================== CAMERA RING ========================= -->
  <!-- 360° ring: front (+x), rear (-x), left (+y), right (-y).
       Each yaw points the lens (+Z optical) outward in that direction. -->
  <xacro:zed_x_camera name="front" parent="base_link"
        x="${mast_x + ring_r}" y="${mast_y}"          z="${cam_z}" roll="0" pitch="${cam_pitch}" yaw="0"/>
  <xacro:zed_x_camera name="left"  parent="base_link"
        x="${mast_x}"          y="${mast_y + ring_r}" z="${cam_z}" roll="0" pitch="${cam_pitch}" yaw="${ pi/2}"/>
  <xacro:zed_x_camera name="rear"  parent="base_link"
        x="${mast_x - ring_r}" y="${mast_y}"          z="${cam_z}" roll="0" pitch="${cam_pitch}" yaw="${ pi}"/>
  <xacro:zed_x_camera name="right" parent="base_link"
        x="${mast_x}"          y="${mast_y - ring_r}" z="${cam_z}" roll="0" pitch="${cam_pitch}" yaw="${-pi/2}"/>

</robot>
