<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Shared visual materials (RGBA 0-1). Visual only; ignored by physics/TF. -->
  <material name="chassis_grey"><color rgba="0.30 0.30 0.32 1.0"/></material>
  <material name="wheel_black"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="lidar_blue"><color rgba="0.10 0.35 0.80 1.0"/></material>
  <material name="camera_green"><color rgba="0.10 0.70 0.35 1.0"/></material>
  <material name="mast_alu"><color rgba="0.65 0.65 0.68 1.0"/></material>
</robot>
